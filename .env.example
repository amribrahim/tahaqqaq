# ---- Database (docker-compose provides this by default) ----
DATABASE_URL=postgresql://tahqaq:tahqaq@db:5432/tahqaq

# ---- Embeddings ----
# local  : fastembed ONNX model, runs on CPU (the default, used by docker-compose, production and tests)
# openai : text-embedding-3-small via OPENAI_API_KEY (for very small hosts; the corpus must be embedded the same way)
EMBEDDER=local
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OPENAI_API_KEY=

# ---- Language models (optional; a ruling is NEVER produced by a model) ----
# One OpenAI-compatible client with automatic fallback. LLM_PROVIDER=none turns the explanations off;
# verification keeps working. A Gemini key also adds gemini-3.1-flash-lite as a backup, and a Groq key adds
# openai/gpt-oss-20b as the last fallback (each has its own free quota).
# gemini (aistudio.google.com/apikey) | groq (console.groq.com/keys) | openrouter (openrouter.ai/keys)
# | cerebras (cloud.cerebras.ai) | anthropic
LLM_PROVIDER=none
LLM_FALLBACKS=groq,openrouter
LLM_MODEL=                      # optional override of the primary provider's default model
GEMINI_API_KEY=
GROQ_API_KEY=                   # also used by Sanad's speech-to-text (Whisper on Groq)
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Sanad's voice (text to speech) ----
# Piper runs on the server with no key and no quota (the Docker image downloads the voices to /opt/piper).
TTS_PIPER_DIR=
TTS_PIPER_VOICE_AR=ar_JO-kareem-medium
TTS_PIPER_VOICE_EN=en_US-ryan-medium
# Groq Orpheus voices are used first when set (accept the model terms in the Groq console first).
TTS_GROQ_VOICE_AR=
TTS_GROQ_VOICE_EN=
# Gemini TTS is off by default: its free tier allows 10 requests a day.
TTS_GEMINI=false

# ---- Human review ----
# The review PDF is the site's own result page printed by a headless Chromium.
FRONTEND_URL=https://tahaqqaq.pages.dev     # local stack: http://web:3000 (set in docker-compose.yml)
PDF_CHROMIUM_PATH=                           # empty: /usr/bin/chromium in Docker, else the installed Chrome
# Optional: also forward each review request to a webhook (Slack/Discord/email relay).
REVIEW_WEBHOOK_URL=

# ---- CORS: comma-separated origins allowed to call the API ----
CORS_ORIGINS=http://localhost:3000

# ---- Production server only (in /opt/tahaqqaq/.env, never in git) ----
# API_HOST=<ip-with-dashes>.sslip.io        # the hostname Caddy serves and certifies
# POSTGRES_PASSWORD=<a strong password>

# ---- Frontend (baked into the static site at build time) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WEB3FORMS_KEY=<public form key>   # contact form for review requests (a default is built in)
