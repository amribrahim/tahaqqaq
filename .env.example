# ---- Database (docker-compose provides this by default) ----
DATABASE_URL=postgresql://tahqaq:tahqaq@db:5432/tahqaq

# ---- Embeddings ----
# local  : fastembed ONNX model, runs on CPU, used by docker-compose and tests
# openai : text-embedding-3-small via OPENAI_API_KEY (recommended on Render free tier)
EMBEDDER=local
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OPENAI_API_KEY=

# ---- LLM explanation (optional; the grade is NEVER produced by the LLM) ----
# One OpenAI-compatible client with automatic fallback. LLM_PROVIDER=none disables the card.
# gemini (aistudio.google.com/apikey) | groq (console.groq.com/keys) | openrouter (openrouter.ai/keys)
# | cerebras (cloud.cerebras.ai) | anthropic
LLM_PROVIDER=none
LLM_FALLBACKS=groq,openrouter
LLM_MODEL=                      # optional override of the primary provider's default model
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Human review (optional) ----
# If set, "طلب مراجعة بشرية" forwards the text to this webhook (Slack/Discord/email relay).
# Nothing is stored server-side either way.
REVIEW_WEBHOOK_URL=

# ---- CORS: comma-separated origins allowed to call the API ----
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
